# Variables de entorno para Elecciones (NO commitear .env real)
# Copiar a .env y completar valores reales

# GitHub
GITHUB_REPOSITORY=Tito-67ai/Elecciones
GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# Config Server
CONFIG_SERVER_URI=https://github.com/Tito-67ai/Elecciones.git
CONFIG_SERVER_BRANCH=backend
CONFIG_SERVER_SEARCH_PATHS=config

# Gateway
GATEWAY_INTERNAL_SECRET=EleccionesClaveInternaGateway2026

# JWT
JWT_SECRET=EleccionesClaveJwtSuperSecreta2026ParaFirmaHS256
JWT_EXPIRATION=3600

# Base de datos (MySQL en prod, H2 en dev)
MYSQL_ROOT_PASSWORD=cambiar_en_produccion
MYSQL_DATABASE=elecciones
MYSQL_USER=elecciones_user
MYSQL_PASSWORD=cambiar_en_produccion

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Eureka
EUREKA_URI=http://registry:8761/eureka/

# Observabilidad (OpenTelemetry Collector endpoint)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Entorno
SPRING_PROFILES_ACTIVE=docker